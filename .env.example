# Required for LLM-based extraction, validation and Q&A
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b

# Optional tracing with LangSmith
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rfp-intelligence-platform

# Optional limits
RFP_TOP_K_EVIDENCE=6
RFP_CANDIDATE_K=20
RFP_MAX_RETRIES=2
